{
  "name": "openfeel-dsh",
  "version": "1.5.21",
  "description": "将 OpenFeel 的工作记录与开发流程接入 DeepSeek Harness：记住项目做到哪、下一步做什么，默认自由模式，也可切到按步骤走的流程模式",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20.17.0",
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Liuary/OpenFeel.git",
    "directory": "dsh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "openfeel": {
    "adapter": "dsh",
    "requiresCli": ">=1.5.21"
  },
  "keywords": [
    "openfeel",
    "dsh",
    "deepseek-harness",
    "adapter",
    "workflow",
    "governance"
  ]
}
