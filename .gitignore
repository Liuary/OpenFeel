node_modules/
dist/

# 私域目录（.openfeel 工作区规范：个人日志/笔记/审查/Bug 不纳入版本管理）
.openfeel/users/
# 项目级临时目录（共享数据/构建产物，不纳入版本管理）
.openfeel/tmp/
coverage/

# update 状态与冲突文件（不纳入版本管理）
.openfeel/update_state.json
.openfeel/update_conflicts/
# preflight 账本（读命令副作用，运行时生成，不纳入版本管理）
.openfeel/dev/.preflight.json

# DSH 适配器目录内的运行时残留：在 dsh/ 下跑 CLI 会建 .openfeel/tmp/session.json，
# 它不是 OpenFeel 工作区，根级 .openfeel/tmp/ 规则因带斜杠而锚定，需单独声明。
dsh/.openfeel/
