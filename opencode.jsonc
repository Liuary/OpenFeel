{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "feel",
  "instructions": [
    "AGENTS.md",
    ".opencode/instructions/core.md"
  ],
  "skills": {
    "openfeel-agent-model-check": ".opencode/skills/openfeel-agent-model-check",
    "openfeel-bug-acceptance": ".opencode/skills/openfeel-bug-acceptance",
    "openfeel-check-kb": ".opencode/skills/openfeel-check-kb",
    "openfeel-get-bugs": ".opencode/skills/openfeel-get-bugs",
    "openfeel-get-stage-status": ".opencode/skills/openfeel-get-stage-status",
    "openfeel-health": ".opencode/skills/openfeel-health",
    "openfeel-model-check": ".opencode/skills/openfeel-model-check",
    "openfeel-model-config": ".opencode/skills/openfeel-model-config",
    "openfeel-recover": ".opencode/skills/openfeel-recover",
    "openfeel-roadmap": ".opencode/skills/openfeel-roadmap",
    "openfeel-search-kb": ".opencode/skills/openfeel-search-kb",
    "openfeel-sync-status": ".opencode/skills/openfeel-sync-status",
    "openfeel-update-stage-status": ".opencode/skills/openfeel-update-stage-status",
    "openfeel-wizard": ".opencode/skills/openfeel-wizard"
  },
  "agent": {
    "openfeel-vision": {
      "model": "alibaba-cn/qwen3-vl-plus"
    },
    "openfeel-reviewer": {
      "model": "zhipuai/glm-5.2"
    }
  },
  "experimental": {
    "agent_manager_tool": true
  },
  "permission": "allow"
}
